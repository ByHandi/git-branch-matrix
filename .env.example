# Copy to .env.local for `npm run dev` / `npm start`, and to .env.docker for `npm run docker:up`.
# Every value is optional — the defaults shown are what the app uses when a key is unset.

# Postgres. Falls back to DATABASE_URL, then postgres://$USER@localhost:5432/branch_matrix.
# In .env.docker use host.docker.internal instead of localhost: inside the container,
# localhost is the container itself.
BRANCH_MATRIX_DB=postgresql://postgres:postgres@localhost:5432/branch_matrix

# Folder the folder picker and the scan are confined to. Default: $HOME.
# docker-compose.yml sets ${HOME}/projects.
# BRANCH_MATRIX_ROOT=/Users/you/projects

# Where the app reaches scripts/fetch-helper.mjs. docker-compose.yml sets
# http://host.docker.internal:4329.
# FETCH_HELPER_URL=http://127.0.0.1:4329

# The fetch helper does NOT read this file: it runs under launchd and takes FETCH_HELPER_PORT
# (default 4329) and BRANCH_MATRIX_ROOT (default ~/projects) from your shell when you run
#   FETCH_HELPER_PORT=4329 ./scripts/fetch-helper.sh install
# Change the port there and FETCH_HELPER_URL above together.

# Timezone for server-rendered dates until the browser switches to its own zone.
# Inlined at build time, so it has no effect in .env.docker (read only when the container starts).
# NEXT_PUBLIC_TIME_ZONE=Asia/Jakarta

# The port is NOT read from here: the npm scripts expand ${PORT:-4321} in the shell before Next
# loads this file. Use `PORT=5000 npm run dev`.
