# Copy to .env.local for `npm run dev` / `npm start`, and to .env.docker for `npm run docker:up`.
# Every value is optional — the defaults shown are what the app uses when a key is unset.
# `npm run docker:up` reads .env.docker twice: to fill docker-compose.yml (root, port, timezone)
# and as the container's environment.

# ── Postgres ──────────────────────────────────────────────────────────────────────────────────
# Either bring your own, or (Docker only) let docker-compose.yml run one for you.
#
# Your own: falls back to DATABASE_URL, then postgres://$USER@localhost:5432/branch_matrix.
# In .env.docker use host.docker.internal instead of localhost: inside the container,
# localhost is the container itself.
BRANCH_MATRIX_DB=postgresql://postgres:postgres@localhost:5432/branch_matrix
#
# Bundled (Docker only): uncomment COMPOSE_PROFILES and remove BRANCH_MATRIX_DB above. The schema
# is applied on every `npm run docker:up`, and the data lives in the `pgdata` volume.
# COMPOSE_PROFILES=db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# Host port for it, loopback only — a native `npm run dev` can then use
# BRANCH_MATRIX_DB=postgresql://postgres:postgres@localhost:5433/branch_matrix
# DB_PORT=5433

# Folder the folder picker and the scan are confined to. Must be absolute.
# Default: $HOME natively, $HOME/projects in Docker — where it is also the read-only mount.
# BRANCH_MATRIX_ROOT=/home/you/code

# Default issue-tracker link for ticket IDs, with {ticket} where the ID goes. A repo's own
# "Ticket URL" (Edit repo) overrides it; with neither, ticket IDs are not linked.
# BRANCH_MATRIX_TICKET_URL=https://your-org.atlassian.net/browse/{ticket}

# Where the app reaches scripts/fetch-helper.mjs.
# Default: http://127.0.0.1:4329 natively, http://host.docker.internal:4329 in Docker.
# FETCH_HELPER_URL=http://127.0.0.1:4329

# The fetch helper does NOT read this file. It takes FETCH_HELPER_PORT (default 4329),
# FETCH_HELPER_HOST (default 127.0.0.1) and BRANCH_MATRIX_ROOT (default ~/projects) from the shell
# that starts it: `npm run fetch-helper`, or on macOS `./scripts/fetch-helper.sh install`.
# Change its port and FETCH_HELPER_URL above together.

# Timezone (IANA name) for server-rendered dates until the browser switches to its own zone.
# Inlined at build time; docker-compose.yml passes it in as a build arg. Default: UTC.
# NEXT_PUBLIC_TIME_ZONE=Europe/Berlin

# Docker only: the container's clock and log timestamps. Default: UTC.
# TZ=Europe/Berlin

# Natively the port is NOT read from here: the npm scripts expand ${PORT:-4321} in the shell
# before Next loads this file, so use `PORT=5000 npm run dev`. In .env.docker it does work — it
# picks the host port docker-compose.yml publishes on 127.0.0.1.
# PORT=4321
